Das Dokument darf für persönliche Lernzwecke genutzt werden; Urhebervermerk beibehalten.`}function analyze(){
 const feedback=[];const put=(name,good,positive,needed)=>feedback.push({name,good,message:good?positive:needed});
 const obs=choice('obs'),phrase=choice('phrase');
 put('Beobachtung und Hypothese',obs==='b','Du trennst die unmittelbar beobachtbaren Handlungen von möglichen Ursachen.','Prüfe die Unterscheidung erneut: Sichtbares Verhalten und wörtliche Äußerungen sind Beobachtungen; Motive und Diagnosen sind Deutungen.');
 put('Traumasensible Ansprache',phrase==='b','Deine Auswahl reduziert Druck und eröffnet Orientierung, sofern keine akute Gefahr besteht.','Überlege, wie du mit wenigen Worten Sicherheit und Orientierung geben kannst, ohne zu drohen oder zu beschämen.');
 const fields=[
 ['Selbstregulation','selfhelp','Du hast eine persönliche Mikrohandlung notiert.','Ergänze eine kurze, unauffällige Handlung für deine Selbstregulation.'],
 ['Mögliche Ursachen','hypothesis','Du hast mögliche Erklärungen gesammelt. Halte sie als Hypothesen offen.','Notiere mindestens zwei mögliche Erklärungen, ohne sie als Tatsache festzulegen.'],
 ['Sicherheit und Aufsicht','safety','Du hast eine Sicherheitsprüfung vorgesehen. Gleiche sie mit dem Krisenplan deiner Schule ab.','Ergänze, wie du Gefahren, Abstand, Aufsicht und nötige Unterstützung prüfst.'],
 ['Orientierung für die Klasse','classroom','Du hast die übrigen Kinder in deinem Plan berücksichtigt.','Formuliere einen klaren Auftrag für die übrigen Kinder.'],
 ['Erster Satz an das Kind','sentence','Du hast eine eigene Ansprache formuliert. Prüfe sie auf Kürze, Klarheit und Beschämungsfreiheit.','Notiere einen kurzen, nicht drohenden Satz, sofern die Sicherheitslage eine Ansprache zulässt.'],
 ['Weiterer Fallverlauf','nextaction','Du hast eine Folgehandlung für den gewählten Verlauf benannt.','Ergänze einen konkreten nächsten Schritt und den passenden Hilfeweg.'],
 ['Wiedereinstieg','reentry','Du hast die Rückkehr in den Unterricht bedacht.','Ergänze einen würdevollen Wiedereinstieg ohne öffentliche Bloßstellung.'],
 ['Team und Krisenweg','team','Du hast eine Teamabsprache festgehalten.','Notiere, wer unterstützt, die Aufsicht übernimmt und wann alarmiert wird.'],
 ['Praxistransfer','ifthen','Du hast einen Wenn-dann-Plan für die Praxis erstellt.','Formuliere einen konkreten Wenn-dann-Satz für die nächste Unterrichtssituation.']
 ];
 for(const [name,id,yes,no] of fields)put(name,!!document.getElementById(id).value.trim(),yes,no);
 const complete=feedback.filter(f=>f.good).length;
 const missing=feedback.filter(f=>!f.good);
 const lead=missing.length===0?'Du hast alle vorgesehenen Bearbeitungspunkte ausgefüllt. Nutze die Hinweise für eine fachliche Prüfung im Team.':`Du hast ${complete} von ${feedback.length} Reflexions- und Planungspunkten bearbeitet. ${missing.length} Punkt${missing.length===1?' ist':'e sind'} noch offen oder sollten erneut geprüft werden.`;
 const summary=['Achte bei der Umsetzung immer auf den konkreten Gefährdungsgrad und die verbindlichen schulischen Abläufe.'];
 if(choice('branch')==='danger')summary.push('Für Verlauf C hat die unmittelbare Sicherung und Alarmierung Vorrang vor Gesprächs- oder Regulationsübungen.');
 if(Number(document.getElementById('stress').value)>=8)summary.push('Du hast eine sehr hohe eigene Anspannung angegeben: Plane ausdrücklich Unterstützung und möglichst kurze, sichere Handlungsschritte ein.');
 if(!choice('obs')||!choice('phrase'))summary.push('Einzelne Auswahlfragen sind noch unbeantwortet; bearbeite sie für eine vollständigere Rückmeldung.');
 const container=document.getElementById('feedback');container.replaceChildren();
 const headline=document.createElement('div');headline.className='result-head';headline.textContent='Dein Lernstand im Fallbeispiel';container.append(headline);
 const p=document.createElement('p');p.textContent=lead;container.append(p);
 const list=document.createElement('div');list.className='feedback-list';
 feedback.forEach(f=>{const d=document.createElement('div');d.className='feedback-item'+(f.good?'':' attention');const h=document.createElement('strong');h.textContent=(f.good?'Berücksichtigt: ':'Noch prüfen: ')+f.name;const t=document.createElement('span');t.textContent=f.message;d.append(h,t);list.append(d)});container.append(list);
 summary.forEach(s=>{const t=document.createElement('p');t.className='note';t.textContent=s;container.append(t)});
 return 'PERSÖNLICHE AUSWERTUNG (orientierende Lernhilfe)\n'+lead+'\n\n'+feedback.map(f=>(f.good?'Berücksichtigt – ':'Noch prüfen – ')+f.name+': '+f.message).join('\n')+'\n\n'+summary.join('\n');
}
function report(){document.getElementById('report').textContent=buildReport();analyze()}function downloadText(){let b=new Blob([analyze()+"\n\n"+buildReport()],{type:'text/plain;charset=utf-8'}),u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download='TPD_mein_Handlungsplan.txt';a.click();URL.revokeObjectURL(u)}function resetAll(){if(confirm('Alle Eingaben in diesem Browser löschen und neu beginnen?')){localStorage.removeItem('tpd-falluebung-v1');location.reload()}}ids.forEach(id=>document.getElementById(id).addEventListener('input',save));
const scenarios={
 ben:{name:'A · Lautes Verhalten / Arbeitsverweigerung',story:'Mathematik in einer fünften Klasse mit elf Kindern. Ein zehnjähriges Kind wirkt zunehmend unruhig, beginnt die Aufgabe nicht und ruft nach wiederholter Aufforderung: „Ich kann das nicht! Lass mich in Ruhe!“ Es schiebt den Stuhl zurück und wirft das Blatt auf den Boden. Die Klasse wird unruhig.',focus:'Fokus: Anforderungen senken, nicht beschämen, ruhige Ansprache, Klasse orientieren.',obs:['Das Kind will gezielt provozieren.','Das Kind steht auf, schreit und wirft das Arbeitsblatt herunter.','Das Kind erlebt sicher einen Flashback.'],branches:['A: Das Kind wird ruhiger.','B: Das Kind schreit weiter.','C: Es wirft harte Gegenstände.']},
 leave:{name:'B · Raum verlassen',story:'Während eines unerwarteten Raumwechsels steht ein Kind auf, ruft „Ich gehe!“ und bewegt sich schnell zur Klassentür. Im Flur befinden sich weitere Kinder. Die Lehrkraft hat gleichzeitig die Aufsicht über die Klasse.',focus:'Fokus: Aufsicht, sichere Wege, Unterstützung und nicht bedrohliche Kontaktaufnahme. Ein Weglaufen kann eine Gefahrenlage auslösen.',obs:['Das Kind will die Lehrkraft bloßstellen.','Das Kind steht auf, ruft „Ich gehe!“ und läuft zur Tür.','Das Kind hat sicher ein Trauma.'],branches:['A: Das Kind bleibt ansprechbar und hält an.','B: Es geht Richtung Flur weiter.','C: Es läuft in einen akut gefährlichen Bereich.']},
 freeze:{name:'C · Rückzug / Erstarren',story:'Nach einer lauten Bemerkung im Klassenraum sitzt ein Kind still am Tisch, reagiert kaum auf Ansprache und schaut auf einen Punkt. Einige Mitschüler bemerken das Verhalten. Der Grund ist unklar.',focus:'Fokus: Belastung und medizinische Ursachen offen prüfen, Druck vermeiden, Orientierung ermöglichen und bei auffälligem Bewusstseinszustand medizinische Hilfe veranlassen.',obs:['Das Kind ignoriert absichtlich die Lehrkraft.','Das Kind sitzt still, blickt auf einen Punkt und reagiert kaum auf Ansprache.','Das Kind dissoziiert mit Sicherheit.'],branches:['A: Das Kind reagiert wieder auf einfache Ansprache.','B: Es bleibt kaum ansprechbar.','C: Es zeigen sich Hinweise auf einen medizinischen Notfall.']},
 conflict:{name:'D · Konflikt zwischen Kindern',story:'In einer Gruppenarbeit geraten zwei Kinder in Streit. Eines schreit, das andere stößt einen Stuhl weg. Mehrere Kinder stehen auf und beobachten die Auseinandersetzung. Die Lehrkraft muss die Beteiligten und die Klasse sichern.',focus:'Fokus: Schutz aller Beteiligten, eindeutige Grenzen ohne Demütigung, Hilfe holen und getrennte Nachbereitung.',obs:['Beide Kinder wollen absichtlich den Unterricht sabotieren.','Zwei Kinder streiten laut; eines stößt einen Stuhl weg.','Beide haben eine Traumafolgestörung.'],branches:['A: Beide gehen auf Abstand und werden ruhiger.','B: Der Streit dauert an.','C: Es entsteht akute körperliche Gefährdung.']}
};
function caseType(){return val('caseSelect')==='own'?val('caseType'):val('caseSelect')}
