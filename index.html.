const names=['Fall','Selbstcheck','Verstehen','Akut handeln','Fallverlauf','Transfer','Ergebnis'];let current=0;const nav=document.getElementById('nav');names.forEach((n,i)=>{let b=document.createElement('button');b.className='tab';b.textContent=(i+1)+' · '+n;b.onclick=()=>go(i);b.dataset.index=i;nav.appendChild(b)});let ids=['caseSelect','caseTitle','caseType','caseDescription','caseContext','first','stress','signal','selfhelp','hypothesis','safety','classroom','sentence','nextaction','reentry','team','ifthen'];function val(id){return document.getElementById(id).value.trim()||'—'}function choice(n){return document.querySelector('input[name="'+n+'"]:checked')?.value||''}function save(){let state={};ids.forEach(id=>state[id]=document.getElementById(id).value);['obs','phrase','branch'].forEach(n=>state[n]=choice(n));try{localStorage.setItem('tpd-falluebung-v1',JSON.stringify(state))}catch(e){}}function restore(){try{let s=JSON.parse(localStorage.getItem('tpd-falluebung-v1')||'{}');ids.forEach(id=>{if(s[id]!==undefined)document.getElementById(id).value=s[id]});['obs','phrase','branch'].forEach(n=>{let el=document.querySelector('input[name="'+n+'"][value="'+s[n]+'"]');if(el)el.checked=true})}catch(e){}document.getElementById('stressvalue').textContent=val('stress');branch()}function go(n){save();current=n;document.querySelectorAll('.panel').forEach((el,i)=>el.classList.toggle('active',i===n));document.querySelectorAll('.tab').forEach((el,i)=>{el.setAttribute('aria-current',i===n?'step':'false')});document.getElementById('bar').style.width=((n+1)/7*100)+'%';if(n===6)report();window.scrollTo({top:0,behavior:'smooth'})}function checkObs(){let b=choice('obs');document.getElementById('obsfeedback').textContent=b==='b'?'Passend: Das ist eine Beschreibung beobachtbaren Verhaltens. Über die Ursache wissen wir damit noch nichts.':b?'Das ist eine mögliche Deutung, keine gesicherte Beobachtung. Halte dich zunächst an sichtbare Handlungen und wörtliche Aussagen.':'Wähle zuerst eine Antwort aus.';save()}function checkPhrase(){let b=choice('phrase');document.getElementById('phrasefeedback').textContent=b==='b'?'Geeignete Option, sofern keine unmittelbare Gefahr besteht: Sie reduziert Anforderungen und vermittelt Orientierung. Tonfall, Abstand und individuelle Situation bleiben entscheidend.':b?'Dieser Satz kann Druck oder Beschämung verstärken. Bei akuter Gefahr zuerst schützen; sonst kurz, klar und nicht drohend ansprechen.':'Wähle zuerst eine Antwort aus.';save()}function branch(){['calm','loud','danger'].forEach(x=>document.getElementById('b'+x).classList.toggle('active',choice('branch')===x));save()}function buildReport(){let map={calm:'A – Situation entspannt sich',loud:'B – Anspannung bleibt hoch',danger:'C – akute Gefahr'};return `TRAUMAPÄDAGOGIK DÖHLER · INTERAKTIVE FALLÜBUNG\n\nGEWÄHLTER FALL: ${caseName()}\nFALLBESCHREIBUNG: ${caseNarrative()}\n\nMeine spontane Reaktion: ${val('first')}\n\n1. SELBSTWAHRNEHMUNG\nAnspannung: ${val('stress')}/10\nFrühwarnzeichen: ${val('signal')}\nHilfreiche Mikrohandlung: ${val('selfhelp')}\n\n2. VERHALTEN VERSTEHEN\nDenkbare Ursachen (Hypothesen): ${val('hypothesis')}\n\n3. AKUT HANDELN\nSicherheitsprüfung: ${val('safety')}\nErster Satz: ${val('sentence')}\nAuftrag an die Klasse: ${val('classroom')}\n\n4. FALLVERLAUF\n${map[choice('branch')]||'—'}\nMeine nächste Handlung: ${val('nextaction')}\n\n5. RÜCKKEHR UND TEAM\nWiedereinstieg: ${val('reentry')}\nTeamabsprache: ${val('team')}\nWenn-dann-Plan: ${val('ifthen')}\n\nMERKSATZ\nWahrnehmen → mich soweit möglich regulieren → Sicherheit und Aufsicht prüfen → Orientierung geben → Unterstützung organisieren → Rückkehr → Nachsorge.\n\nHinweis: Bei Gefahr haben schulische Sicherheits- und Notfallverfahren Vorrang.

